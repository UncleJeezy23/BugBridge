PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# PostgreSQL is recommended for the hosted demo. Leave blank only for lightweight local development.
DATABASE_URL=
DATABASE_SSL=false

# Screenshot/file storage. For cloud deployment use the mounted persistent-volume path, e.g. /data.
STORAGE_ROOT=

# Identity modes:
# disabled = local development bypass
# demo = fixed demo identity
# local_account = invitation-only email/password accounts stored in PostgreSQL
# upstream_header = trusted external identity headers from an authenticated gateway
IDENTITY_MODE=disabled
ALLOWED_IDENTITY_DOMAIN=example.com
ENFORCE_IDENTITY_DOMAIN=false
DEMO_IDENTITY_EMAIL=admin@example.com
DEMO_IDENTITY_NAME=Demo Admin

# Local-account demo settings.
LOCAL_AUTH_SESSION_HOURS=12
LOCAL_AUTH_INVITE_HOURS=48
LOCAL_AUTH_COOKIE_NAME=bugbridge_session
LOCAL_AUTH_SECURE_COOKIE=false
LOCAL_AUTH_BOOTSTRAP_PASSWORD=

# Only for upstream_header mode. Never expose this mode directly to untrusted clients.
IDENTITY_EMAIL_HEADER=x-authenticated-email
IDENTITY_NAME_HEADER=x-authenticated-name
IDENTITY_ID_HEADER=x-authenticated-user-id

# Creates the initial Admin only when the access table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Portfolio Demo Admin

# Optional signed outbound webhooks. Both URL and secret are required.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_EVENTS=report.created,report.status_changed,report.note_added,report.assignee_changed

REPORT_RECIPIENT_EMAIL=

# Optional SMTP for invitations/report mail. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BugBridge <noreply@example.com>

# Free hosted trial: private R2 screenshots + Neon PostgreSQL.
# local preserves existing disk-based development; r2 requires all four R2 values.
SCREENSHOT_STORAGE=local
REQUIRE_PERSISTENT_STORAGE=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
